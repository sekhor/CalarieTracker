{
  "id": "/",
  "name": "CalorieAI",
  "short_name": "CalorieAI",
  "description": "AI-powered calorie tracking with meal logging, nutrition analytics, and mobile-friendly install support.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b0f19",
  "theme_color": "#0b0f19",
  "lang": "en",
  "dir": "ltr",
  "categories": ["health", "lifestyle", "productivity"],
  "icons": [
